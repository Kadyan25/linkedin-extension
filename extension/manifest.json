{
  "manifest_version": 3,
  "name": "LinkedIn Profile Scraper & Engagement",
  "version": "1.1.1",
  "description": "Scrape LinkedIn profiles and assist with feed engagement",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Tools"
  }
}
